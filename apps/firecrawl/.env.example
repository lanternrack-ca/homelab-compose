# Copy to .env and edit before the first start:  cp .env.example .env

HOST_PORT=3000
PORT=3000
INTERNAL_PORT=3002
HOST=0.0.0.0

# Queue broker & rate limit stores
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape
NUQ_RABBITMQ_URL=amqp://rabbitmq:5672

# PostgreSQL database configuration
POSTGRES_USER=postgres
# set a strong password
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432

# Authentication & Admin Dashboard
USE_DB_AUTHENTICATION=false
# generate with: openssl rand -hex 32
BULL_AUTH_KEY=change-me
BULL_AUTH_KEY_PATH_ROUTES=true
# generate with: openssl rand -hex 32
TEST_API_KEY=change-me

# Worker Concurrency & Harness Tuning
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3
HARNESS_STARTUP_TIMEOUT_MS=60000
ENV=local
