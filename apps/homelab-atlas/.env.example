# Copy to .env and edit before the first start:  cp .env.example .env

# Also read by compose.yml
ATLAS_VERSION=0.12.0
ATLAS_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# generate with: openssl rand -hex 32
ATLAS_API_TOKEN=change-me
# generate with: openssl rand -hex 32
ATLAS_COLLECTOR_TOKEN=change-me
ATLAS_NMAP_ALLOWED_CIDRS=
ATLAS_BIND=127.0.0.1
# generate with: openssl rand -hex 32
ATLAS_DOCKER_API_KEY=change-me
# generate with: openssl rand -hex 32
ATLAS_HAWSER_TOKEN=change-me
ATLAS_DOCKER_HOST=unix:///var/run/docker.sock
