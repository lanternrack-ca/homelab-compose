# Copy to .env and edit before the first start:  cp .env.example .env

CHATTO_PORT=3000
PUBLIC_URL=http://localhost:3000
PUID=1000
PGID=1000

# NATS JetStream connectivity
# generate with: openssl rand -hex 32
NATS_TOKEN=change-me
CHATTO_NATS_EMBEDDED_ENABLED=false
CHATTO_NATS_CLIENT_URL=nats://nats:4222
CHATTO_NATS_CLIENT_AUTH_METHOD=token
# generate with: openssl rand -hex 32
CHATTO_NATS_CLIENT_TOKEN=change-me

# Web server and cryptographic keys
CHATTO_WEBSERVER_URL=http://localhost:3000
CHATTO_WEBSERVER_PORT=4000
# generate with: openssl rand -hex 32
CHATTO_WEBSERVER_COOKIE_SIGNING_SECRET=change-me
# generate with: openssl rand -hex 32
CHATTO_WEBSERVER_COOKIE_ENCRYPTION_SECRET=change-me
# generate with: openssl rand -hex 32
CHATTO_CORE_SECRET_KEY=change-me
# generate with: openssl rand -hex 32
CHATTO_CORE_ASSETS_SIGNING_SECRET=change-me

# Logging and direct login
CHATTO_LOG_LEVEL=info
CHATTO_LOG_FORMAT=json
CHATTO_AUTH_DIRECT_REGISTRATION=true
CHATTO_AUTH_DIRECT_LOGIN=true

# Operator CLI control socket
CHATTO_OPERATOR_API_ENABLED=true
CHATTO_OPERATOR_API_SOCKET_PATH=/tmp/chatto/operator.sock
