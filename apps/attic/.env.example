# Copy to .env and edit before the first start:  cp .env.example .env

# Attic Deployment Environment
POSTGRES_USER=attic
# set a strong password
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attic
# generate with: openssl rand -hex 32
ATTIC_SESSION_SECRET=change-me
ATTIC_PORT=8080
HOST_PORT=3000

# Also read by compose.yml
# set a strong password
ATTIC_ADMIN_PASSWORD=change-me
