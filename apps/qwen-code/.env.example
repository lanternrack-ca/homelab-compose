# Copy to .env and edit before the first start:  cp .env.example .env

# path to a checkout of the upstream repo, e.g. git clone <upstream> src
REPO=./src
# generate with: openssl rand -hex 32
QWEN_SERVER_TOKEN=change-me
HOST_PORT=
PORT=4170
HOSTNAME=0.0.0.0
NODE_ENV=production
QWEN_DISABLE_AUTO_UPDATE=1
CI=1

# Also read by compose.yml
IMG=ghcr.io/qwenlm/qwen-code:0.27.3
PROJ=qwen-code
