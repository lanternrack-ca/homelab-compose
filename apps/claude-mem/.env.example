# Copy to .env and edit before the first start:  cp .env.example .env

POSTGRES_USER=claudemem_admin
# set a strong password
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claude_mem
CLAUDE_MEM_RUNTIME=server-beta
CLAUDE_MEM_QUEUE_ENGINE=bullmq
CLAUDE_MEM_AUTH_MODE=api-key
CLAUDE_MEM_HOST=0.0.0.0
CLAUDE_MEM_SERVER_HOST=0.0.0.0
CLAUDE_MEM_SERVER_PORT=37877
CLAUDE_MEM_REDIS_URL=redis://valkey:6379
CLAUDE_MEM_REDIS_MODE=docker
CLAUDE_MEM_QUEUE_REDIS_PREFIX=claude_mem_37877
CLAUDE_MEM_CHROMA_ENABLED=false
CLAUDE_MEM_GENERATION_DISABLED=true
CLAUDE_MEM_SERVER_VECTOR_SEARCH=auto
CLAUDE_MEM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Also read by compose.yml
HOST_PORT=
CLAUDE_MEM_SERVER_PROVIDER=claude
# generate with: openssl rand -hex 32
ANTHROPIC_API_KEY=change-me
# generate with: openssl rand -hex 32
CLAUDE_MEM_ANTHROPIC_API_KEY=change-me
# generate with: openssl rand -hex 32
GEMINI_API_KEY=change-me
# generate with: openssl rand -hex 32
OPENROUTER_API_KEY=change-me
