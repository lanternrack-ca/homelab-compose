# Copy to .env and edit before the first start:  cp .env.example .env

PROJ=sparkyfitness
SPARKY_PORT=3000
SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
# set a strong password
SPARKY_FITNESS_DB_PASSWORD=change-me
SPARKY_FITNESS_APP_DB_USER=sparky_app
# set a strong password
SPARKY_FITNESS_APP_DB_PASSWORD=change-me
# generate with: openssl rand -hex 32
SPARKY_FITNESS_API_ENCRYPTION_KEY=change-me
# generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
SPARKY_FITNESS_FRONTEND_URL=http://localhost:3000
SPARKY_FITNESS_ADMIN_EMAIL=admin@example.com
SPARKY_FITNESS_DISABLE_SIGNUP=false
SPARKY_FITNESS_DEMO_MODE=false
NODE_ENV=production
TZ=UTC
