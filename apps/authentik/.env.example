# Copy to .env and edit before the first start:  cp .env.example .env

COMPOSE_PORT_HTTP=3000
COMPOSE_PORT_HTTPS=9443

AUTHENTIK_TAG=2026.8.5

PG_USER=authentik
PG_DB=authentik
# generate with: openssl rand -hex 32
PG_PASS=change-me

# generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_WEB__BASE_URL=http://localhost:3000

# Automated Admin Bootstrap Credentials
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
# set a strong password
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
# generate with: openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN=change-me

# Operational Telemetry Controls
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
