# Copy to .env and edit before the first start:  cp .env.example .env

# Media library and database volume mount locations
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

# Application release track (v3 references current stable v3.3.6)
IMMICH_VERSION=v3

# PostgreSQL connection credentials
# set a strong password
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Host port mapping and compose project namespace
HOST_PORT=3000
TZ=Etc/UTC
