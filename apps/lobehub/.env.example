# Copy to .env and edit before the first start:  cp .env.example .env

# Network and Application Endpoints
LOBE_PORT=
APP_URL=
INTERNAL_APP_URL=http://localhost:3210

# Security and Cryptography
# generate with: openssl rand -hex 32
KEY_VAULTS_SECRET=change-me
# generate with: openssl rand -hex 32
AUTH_SECRET=change-me
# generate with: openssl rand -hex 32
GATEWAY_SERVICE_TOKEN=change-me
# generate with: openssl rand -hex 32
JWKS_KEY=change-me
# generate with: openssl rand -hex 32
JWKS_PUBLIC_KEY=change-me

# PostgreSQL Database (ParadeDB PG17)
LOBE_DB_NAME=lobechat
# set a strong password
POSTGRES_PASSWORD=change-me

# Object Storage (RustFS S3)
RUSTFS_PORT=
RUSTFS_ADMIN_PORT=
S3_ENDPOINT=
# generate with: openssl rand -hex 32
RUSTFS_ACCESS_KEY=change-me
# generate with: openssl rand -hex 32
RUSTFS_SECRET_KEY=change-me
RUSTFS_LOBE_BUCKET=lobe

# Agent Gateway
AGENT_GATEWAY_PORT=
DEVICE_GATEWAY_PORT=
AGENT_GATEWAY_URL=
DEVICE_GATEWAY_URL=http://gateway:8788
